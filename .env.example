# OpenAI API 配置
OPENAI_API_KEY=your-openai-api-key-here

# 数据库配置（Docker 环境）
DATABASE_URL=postgresql://postgres:postgres123@postgres:5432/qingpu_ai

# Qdrant 向量数据库
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Redis
REDIS_URL=redis://redis:6379

# 应用配置
ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# 前端配置
REACT_APP_API_URL=http://localhost:8000
